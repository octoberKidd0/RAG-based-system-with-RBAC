 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about="Leica Camera AG"
    xmlns:xmp="http://ns.adobe.com/xap/1.0/"
    xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"
   xmp:MetadataDate="2022-07-23T20:22:39+10:00"
   xmpMM:DocumentID="xmp.did:8e4431e1-bb50-4172-b580-705f587b10eb"
   xmpMM:InstanceID="xmp.iid:8e4431e1-bb50-4172-b580-705f587b10eb"
   xmpMM:OriginalDocumentID="DD66A39EEDDAC56C47D8A648CB0DD7A9">
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">18 July 2022. Eli Dar, Afar region. Eli Dar, Afar region. A girl, Fatima, walks with a water container. In eastern Afar, the community at the outskirts of the town of Eli Dar have been experiencing the impact of drought. The grounds that would normally provide a year or more worth of water for the village dried up about 6 months ago and temperatures in the area are into the 40s. Credit: Liz-Loh-Taylor for OCHA Ethiopia.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Climate change</rdf:li>
     <rdf:li> Drought</rdf:li>
     <rdf:li> Emergency</rdf:li>
     <rdf:li> Food Security</rdf:li>
     <rdf:li> Health</rdf:li>
     <rdf:li> Landscape</rdf:li>
     <rdf:li> Ethiopia</rdf:li>
     <rdf:li> Coat</rdf:li>
     <rdf:li> Person</rdf:li>
     <rdf:li> Soil</rdf:li>
    </rdf:Bag>
   </dc:subject>
