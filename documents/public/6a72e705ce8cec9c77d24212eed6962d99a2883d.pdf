   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A man checks the water at a surface water treatment system (SWAT) water point for displaced people at Bentiu IDP site A in Bentiu town. The water point is run by IOM serves over 15,000 IDPs in the area.</rdf:li>
    </rdf:Alt>
   </dc:description>
