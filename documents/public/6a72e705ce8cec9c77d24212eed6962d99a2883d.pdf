   <dc:creator>
    <rdf:Seq>
     <rdf:li>SARAH WAISWA</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A portrait of Nyekuoth Gatdet Bol, 42 outside her shop. She was displaced by floods from Guit county and now lives in the Bentiu IDP site D. With cash assistance from CERF she started a business selling fish in Rubkona and Bentiu markets. She earns over 15,000SSP daily as profit, with whcih she is able to pay her childrens school fees and meet her basic needs.</rdf:li>
    </rdf:Alt>
   </dc:description>
